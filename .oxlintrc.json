{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "complexity": [
      "warn",
      {
        "max": 10,
        "variant": "modified"
      }
    ]
  },
  "ignorePatterns": [
    "conformance/cases/**",
    "target/**",
    "binaries/**",
    "node_modules/**",
    "crates/autoratchet/plugin/**"
  ]
}
