{
  "name": "autoratchet",
  "version": "0.1.0",
  "description": "Prevent code complexity regressions, one pull request at a time. A threshold-aware ratchet on cyclomatic and cognitive complexity for TypeScript and JavaScript, compared against your target branch, with no baseline file to maintain.",
  "license": "Apache-2.0",
  "author": "Jag Reehal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/autoratchet.git"
  },
  "homepage": "https://github.com/jagreehal/autoratchet",
  "bugs": "https://github.com/jagreehal/autoratchet/issues",
  "keywords": [
    "complexity",
    "cyclomatic-complexity",
    "cognitive-complexity",
    "ratchet",
    "quality-gate",
    "code-quality",
    "technical-debt",
    "oxlint",
    "biome",
    "ci",
    "coding-agents"
  ],
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "autoratchet": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internals": {
      "types": "./dist/internals.d.ts",
      "import": "./dist/internals.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config",
    "agent-hooks",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "quality": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "autoratchet": "tsx src/cli.ts"
  },
  "dependencies": {
    "@biomejs/biome": "2.6.7",
    "oxc-parser": "0.158.0",
    "oxlint": "^1.93.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "oxfmt": "0.78.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
